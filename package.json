{
  "name": "@moove/design-system",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "MOOVE Design System for OMS and internal tools: tokens, shadcn/ui components, patterns and Storybook docs.",
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./styles.css": "./src/styles/moove.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist-lib",
    "src/styles"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build -c vite.config.lib.ts && tsc -p tsconfig.lib.json && bun scripts/fix-dts-aliases.ts",
    "prepack": "bun run build:lib",
    "tokens": "bun scripts/build-tokens.ts",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "bun test",
    "test:stories": "vitest run --project=storybook",
    "prestorybook": "bun scripts/check-port.ts 8000",
    "storybook": "storybook dev -p 8000 --exact-port",
    "prestorybook:lan": "bun scripts/check-port.ts 8000",
    "storybook:lan": "storybook dev -p 8000 --exact-port --host 0.0.0.0",
    "build-storybook": "storybook build",
    "registry:build": "bun scripts/build-registry.ts && shadcn build",
    "preview": "vite preview --port 8000 --strictPort",
    "registry:serve": "bun scripts/serve-registry.ts"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.65.0",
    "radix-ui": "^1.8.1",
    "react-day-picker": "^10.0.2",
    "recharts": "3.8.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "@fontsource/anuphan": "^5.3.0",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4",
    "@types/bun": "^1.4.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.5",
    "globals": "^17",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.5",
    "storybook-addon-pseudo-states": "10.6.5",
    "storybook-dark-mode": "5.0.0",
    "tailwindcss": "^4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5.0.5"
  }
}
